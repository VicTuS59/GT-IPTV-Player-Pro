# Live TV recording, r45.
msgid ""
msgstr "Content-Type: text/plain; charset=UTF-8\nLanguage: lt\n"

msgid "Live TV recording"
msgstr "Tiesioginės TV įrašymas"

msgid "Please set the recording folder in the plugin settings."
msgstr "Nustatykite įrašymo aplanką papildinio nuostatose."

msgid "Recording started."
msgstr "Įrašymas pradėtas."

msgid "Recording stopped."
msgstr "Įrašymas sustabdytas."

msgid "Recording failed. Check the storage device."
msgstr "Įrašyti nepavyko. Patikrinkite duomenų saugojimo įrenginį."

msgid "Recording is not available for this stream."
msgstr "Šio srauto įrašymas negalimas."

msgid "Open the channel again to enable recording."
msgstr "Norėdami įjungti įrašymą, atidarykite kanalą iš naujo."
