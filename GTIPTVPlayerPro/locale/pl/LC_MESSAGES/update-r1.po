# Updater 1.8.5-r1: translated failure reasons.
msgid ""
msgstr "Project-Id-Version: GT IPTV Player Pro 1.4.0\nReport-Msgid-Bugs-To: https://github.com/VicTuS59/GT-IPTV-Player-Pro/issues\nPO-Revision-Date: 2026-10-01 19:14+0000\nLast-Translator: GT IPTV Player Pro contributors\nLanguage-Team: pl\nLanguage: pl\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=3; plural=(n == 1) ? 0 : (n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 10 || n % 100 >= 20)) ? 1 : 2;\n"

msgid "Cannot connect to the update server. Check the network and retry."
msgstr "Nie można połączyć się z serwerem aktualizacji. Sprawdź sieć i spróbuj ponownie."

msgid "DNS lookup failed. Check the network settings."
msgstr "Nie udało się rozwiązać nazwy DNS. Sprawdź ustawienia sieci."

msgid "Secure connection failed. Check the receiver date and certificates."
msgstr "Błąd bezpiecznego połączenia. Sprawdź datę i certyfikaty odbiornika."

msgid "Update server returned HTTP {status}. Try again later."
msgstr "Serwer aktualizacji zwrócił HTTP {status}. Spróbuj później."

msgid "Download interrupted. Download the update again."
msgstr "Pobieranie przerwane. Pobierz aktualizację ponownie."

msgid "Storage is read-only."
msgstr "Pamięć jest tylko do odczytu."

msgid "Storage access denied. Check permissions."
msgstr "Odmowa dostępu do pamięci. Sprawdź uprawnienia."

msgid "Update settings could not be read or saved. Restart the receiver."
msgstr "Nie można odczytać lub zapisać ustawień aktualizacji. Uruchom odbiornik ponownie."

msgid "Stop the active recording before updating."
msgstr "Zatrzymaj aktywne nagrywanie przed aktualizacją."

msgid "Pause active downloads before updating."
msgstr "Wstrzymaj aktywne pobieranie przed aktualizacją."

msgid "Activity status could not be checked. Restart the receiver."
msgstr "Nie można sprawdzić stanu aktywności. Uruchom odbiornik ponownie."

msgid "Another update is running. Please wait."
msgstr "Trwa już inna aktualizacja. Proszę czekać."

msgid "Package installation failed. Check the installation log."
msgstr "Instalacja pakietu nie powiodła się. Sprawdź dziennik instalacji."

msgid "Required package missing: {package}."
msgstr "Brak wymaganego pakietu: {package}."

msgid "Package conflict. Check installed packages."
msgstr "Konflikt pakietów. Sprawdź zainstalowane pakiety."

msgid "The package manager is busy. Try again later."
msgstr "Menedżer pakietów jest zajęty. Spróbuj później."

msgid "The package manager is unavailable on this receiver."
msgstr "Menedżer pakietów jest niedostępny na tym odbiorniku."

msgid "Administrator permission is required to install updates."
msgstr "Instalacja aktualizacji wymaga uprawnień administratora."

msgid "Package configuration failed. Restart the receiver and retry."
msgstr "Konfiguracja pakietu nie powiodła się. Uruchom odbiornik ponownie i spróbuj jeszcze raz."

msgid "Unexpected update error. Restart the receiver and retry."
msgstr "Nieoczekiwany błąd aktualizacji. Uruchom odbiornik ponownie i spróbuj jeszcze raz."

msgid "Update installed, but its status could not be saved. Restart the interface."
msgstr "Aktualizacja zainstalowana, ale nie można zapisać jej stanu. Uruchom interfejs ponownie."
