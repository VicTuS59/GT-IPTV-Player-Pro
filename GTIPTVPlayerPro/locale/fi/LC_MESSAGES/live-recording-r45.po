# Live TV recording, r45.
msgid ""
msgstr "Content-Type: text/plain; charset=UTF-8\nLanguage: fi\n"

msgid "Live TV recording"
msgstr "Suoran TV-lähetyksen tallennus"

msgid "Please set the recording folder in the plugin settings."
msgstr "Valitse tallennuskansio lisäosan asetuksista."

msgid "Recording started."
msgstr "Tallennus alkoi."

msgid "Recording stopped."
msgstr "Tallennus päättyi."

msgid "Recording failed. Check the storage device."
msgstr "Tallennus epäonnistui. Tarkista tallennuslaite."

msgid "Recording is not available for this stream."
msgstr "Tätä suoratoistoa ei voi tallentaa."

msgid "Open the channel again to enable recording."
msgstr "Avaa kanava uudelleen ottaaksesi tallennuksen käyttöön."
