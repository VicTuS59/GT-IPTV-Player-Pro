# Updater 1.8.5-r1: translated failure reasons.
msgid ""
msgstr "Project-Id-Version: GT IPTV Player Pro 1.4.0\nReport-Msgid-Bugs-To: https://github.com/VicTuS59/GT-IPTV-Player-Pro/issues\nPO-Revision-Date: 2026-10-01 19:14+0000\nLast-Translator: GT IPTV Player Pro contributors\nLanguage-Team: Indonesian\nLanguage: id\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=1; plural=0;\n"

msgid "Cannot connect to the update server. Check the network and retry."
msgstr "Tidak dapat terhubung ke server pembaruan. Periksa jaringan dan coba lagi."

msgid "DNS lookup failed. Check the network settings."
msgstr "Pencarian DNS gagal. Periksa pengaturan jaringan."

msgid "Secure connection failed. Check the receiver date and certificates."
msgstr "Koneksi aman gagal. Periksa tanggal dan sertifikat penerima."

msgid "Update server returned HTTP {status}. Try again later."
msgstr "Server pembaruan mengembalikan HTTP {status}. Coba lagi nanti."

msgid "Download interrupted. Download the update again."
msgstr "Unduhan terputus. Unduh pembaruan lagi."

msgid "Storage is read-only."
msgstr "Penyimpanan hanya dapat dibaca."

msgid "Storage access denied. Check permissions."
msgstr "Akses penyimpanan ditolak. Periksa izin."

msgid "Update settings could not be read or saved. Restart the receiver."
msgstr "Pengaturan pembaruan tidak dapat dibaca atau disimpan. Mulai ulang penerima."

msgid "Stop the active recording before updating."
msgstr "Hentikan perekaman aktif sebelum memperbarui."

msgid "Pause active downloads before updating."
msgstr "Jeda unduhan aktif sebelum memperbarui."

msgid "Activity status could not be checked. Restart the receiver."
msgstr "Status aktivitas tidak dapat diperiksa. Mulai ulang penerima."

msgid "Another update is running. Please wait."
msgstr "Pembaruan lain sedang berjalan. Harap tunggu."

msgid "Package installation failed. Check the installation log."
msgstr "Pemasangan paket gagal. Periksa log pemasangan."

msgid "Required package missing: {package}."
msgstr "Paket yang diperlukan tidak ada: {package}."

msgid "Package conflict. Check installed packages."
msgstr "Konflik paket. Periksa paket yang terpasang."

msgid "The package manager is busy. Try again later."
msgstr "Pengelola paket sedang sibuk. Coba lagi nanti."

msgid "The package manager is unavailable on this receiver."
msgstr "Pengelola paket tidak tersedia pada penerima ini."

msgid "Administrator permission is required to install updates."
msgstr "Izin administrator diperlukan untuk memasang pembaruan."

msgid "Package configuration failed. Restart the receiver and retry."
msgstr "Konfigurasi paket gagal. Mulai ulang penerima dan coba lagi."

msgid "Unexpected update error. Restart the receiver and retry."
msgstr "Kesalahan pembaruan tak terduga. Mulai ulang penerima dan coba lagi."

msgid "Update installed, but its status could not be saved. Restart the interface."
msgstr "Pembaruan terpasang, tetapi statusnya tidak dapat disimpan. Mulai ulang antarmuka."
