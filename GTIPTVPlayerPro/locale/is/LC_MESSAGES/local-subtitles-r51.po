msgid "Choose a subtitle file"
msgstr "Veldu skjátextaskrá"

msgid "Download folder"
msgstr "Niðurhalsmappa"

msgid "Use this folder"
msgstr "Nota þessa möppu"

msgid "Local subtitles"
msgstr "Staðbundnir skjátextar"

msgid "GT subtitle downloads"
msgstr "Skjátextar sóttir með GT"

msgid "Search subtitle files"
msgstr "Leita að skjátextaskrám"

msgid "No subtitle files found."
msgstr "Engar skjátextaskrár fundust."

msgid "Could not read this folder."
msgstr "Ekki tókst að lesa þessa möppu."

msgid "Could not load this subtitle file."
msgstr "Ekki tókst að hlaða inn þessari skjátextaskrá."

msgid "Could not save the download folder."
msgstr "Ekki tókst að vista niðurhalsmöppuna."

msgid "Download folder saved."
msgstr "Niðurhalsmappa vistuð."

msgid "Subtitle download folder is unavailable. Choose another folder."
msgstr "Niðurhalsmappa skjátexta er ekki tiltæk. Veldu aðra möppu."

msgid "Subtitle file is too large."
msgstr "Skjátextaskráin er of stór."

msgid "Only SRT and VTT subtitle files are supported."
msgstr "Aðeins SRT- og VTT-skjátextaskrár eru studdar."

msgid "Searching subtitle files..."
msgstr "Leitað að skjátextaskrám..."

msgid "Search limit reached. Narrow your search."
msgstr "Leitarmörkum náð. Þrengdu leitina."

msgid "Temporary folder"
msgstr "Tímabundin mappa"

