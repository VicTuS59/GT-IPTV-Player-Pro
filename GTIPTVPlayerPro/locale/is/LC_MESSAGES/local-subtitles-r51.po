msgstr "Tungumál skjátexta"

msgid "Search this folder"
msgstr "Leita í þessari möppu"

msgid "Local subtitle loaded."
msgstr "Staðbundnir skjátextar hlaðnir."

msgid "Automatic detection"
msgstr "Sjálfvirk greining"

msgid "Choose a folder on HDD, USB or connected NAS."
msgstr "Veldu möppu á HDD-diski, USB-drifi eða tengdri NAS-geymslu."

msgid "The temporary folder is cleared when the receiver restarts."
msgstr "Tímabundna mappan er tæmd þegar móttakarinn er endurræstur."

