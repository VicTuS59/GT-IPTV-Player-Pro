# Live TV recording, r45.
msgid ""
msgstr "Content-Type: text/plain; charset=UTF-8\nLanguage: lv\n"

msgid "Live TV recording"
msgstr "TV tiešraides ierakstīšana"

msgid "Please set the recording folder in the plugin settings."
msgstr "Norādiet ierakstu mapi spraudņa iestatījumos."

msgid "Recording started."
msgstr "Ierakstīšana sākta."

msgid "Recording stopped."
msgstr "Ierakstīšana apturēta."

msgid "Recording failed. Check the storage device."
msgstr "Ierakstīšana neizdevās. Pārbaudiet datu glabāšanas ierīci."

msgid "Recording is not available for this stream."
msgstr "Šīs straumes ierakstīšana nav pieejama."

msgid "Open the channel again to enable recording."
msgstr "Lai iespējotu ierakstīšanu, atveriet kanālu vēlreiz."
