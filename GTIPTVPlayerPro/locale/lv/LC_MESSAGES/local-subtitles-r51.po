msgid "Choose a subtitle file"
msgstr "Izvēlieties subtitru failu"

msgid "Download folder"
msgstr "Lejupielādes mape"

msgid "Use this folder"
msgstr "Izmantot šo mapi"

msgid "Local subtitles"
msgstr "Vietējie subtitri"

msgid "GT subtitle downloads"
msgstr "GT subtitru lejupielādes"

msgid "Search subtitle files"
msgstr "Meklēt subtitru failus"

msgid "No subtitle files found."
msgstr "Subtitru faili nav atrasti."

msgid "Could not read this folder."
msgstr "Neizdevās nolasīt šo mapi."

msgid "Could not load this subtitle file."
msgstr "Neizdevās ielādēt šo subtitru failu."

msgid "Could not save the download folder."
msgstr "Neizdevās saglabāt lejupielādes mapi."

msgid "Download folder saved."
msgstr "Lejupielādes mape saglabāta."

msgid "Subtitle download folder is unavailable. Choose another folder."
msgstr "Subtitru lejupielādes mape nav pieejama. Izvēlieties citu mapi."

msgid "Subtitle file is too large."
msgstr "Subtitru fails ir pārāk liels."

msgid "Only SRT and VTT subtitle files are supported."
msgstr "Tiek atbalstīti tikai SRT un VTT subtitru faili."

msgid "Searching subtitle files..."
msgstr "Notiek subtitru failu meklēšana..."

msgid "Search limit reached. Narrow your search."
msgstr "Sasniegts meklēšanas ierobežojums. Sašauriniet meklēšanu."

msgid "Temporary folder"
msgstr "Pagaidu mape"

msgid "Device storage"
msgstr "Ierīces krātuve"

msgid "Up one folder"
msgstr "Vienu mapi augstāk"

msgid "Subtitle language"
msgstr "Subtitru valoda"

msgid "Search this folder"
msgstr "Meklēt šajā mapē"

msgid "Local subtitle loaded."
msgstr "Vietējie subtitri ielādēti."

msgid "Automatic detection"
msgstr "Automātiska noteikšana"

msgid "Choose a folder on HDD, USB or connected NAS."
msgstr "Izvēlieties mapi HDD, USB vai pievienotā NAS ierīcē."

msgid "The temporary folder is cleared when the receiver restarts."
msgstr "Pagaidu mape tiek iztīrīta, restartējot uztvērēju."

#, python-brace-format
msgid "Download folder: {}"
msgstr "Lejupielādes mape: {}"

#, python-brace-format
msgid "Subtitle language: {}"
msgstr "Subtitru valoda: {}"

msgid "Folder is not available."
msgstr "Mape nav pieejama."

msgid "Use temporary folder"
msgstr "Izmantot pagaidu mapi"

msgid "Device folders"
msgstr "Ierīces mapes"

msgid "Downloaded subtitles"
msgstr "Lejupielādētie subtitri"

msgid "Search results"
msgstr "Meklēšanas rezultāti"
