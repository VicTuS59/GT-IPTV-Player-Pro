# Updater 1.8.5-r1: translated failure reasons.
msgid ""
msgstr "Project-Id-Version: GT IPTV Player Pro 1.4.0\nReport-Msgid-Bugs-To: https://github.com/VicTuS59/GT-IPTV-Player-Pro/issues\nPO-Revision-Date: 2026-10-01 19:14+0000\nLast-Translator: GT IPTV Player Pro contributors\nLanguage-Team: fr_FR\nLanguage: fr_FR\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "Cannot connect to the update server. Check the network and retry."
msgstr "Connexion au serveur de mise à jour impossible. Vérifiez le réseau et réessayez."

msgid "DNS lookup failed. Check the network settings."
msgstr "Échec de la résolution DNS. Vérifiez les paramètres réseau."

msgid "Secure connection failed. Check the receiver date and certificates."
msgstr "Échec de la connexion sécurisée. Vérifiez la date et les certificats du récepteur."

msgid "Update server returned HTTP {status}. Try again later."
msgstr "Le serveur de mise à jour a renvoyé HTTP {status}. Réessayez plus tard."

msgid "Download interrupted. Download the update again."
msgstr "Téléchargement interrompu. Téléchargez à nouveau la mise à jour."

msgid "Storage is read-only."
msgstr "Le stockage est en lecture seule."

msgid "Storage access denied. Check permissions."
msgstr "Accès au stockage refusé. Vérifiez les autorisations."

msgid "Update settings could not be read or saved. Restart the receiver."
msgstr "Lecture ou enregistrement des paramètres de mise à jour impossible. Redémarrez le récepteur."

msgid "Stop the active recording before updating."
msgstr "Arrêtez l’enregistrement en cours avant la mise à jour."

msgid "Pause active downloads before updating."
msgstr "Mettez les téléchargements en pause avant la mise à jour."

msgid "Activity status could not be checked. Restart the receiver."
msgstr "Vérification de l’activité impossible. Redémarrez le récepteur."

msgid "Another update is running. Please wait."
msgstr "Une autre mise à jour est en cours. Veuillez patienter."

msgid "Package installation failed. Check the installation log."
msgstr "Échec de l’installation du paquet. Consultez le journal d’installation."

msgid "Required package missing: {package}."
msgstr "Paquet requis manquant : {package}."

msgid "Package conflict. Check installed packages."
msgstr "Conflit de paquets. Vérifiez les paquets installés."

msgid "The package manager is busy. Try again later."
msgstr "Le gestionnaire de paquets est occupé. Réessayez plus tard."

msgid "The package manager is unavailable on this receiver."
msgstr "Le gestionnaire de paquets n’est pas disponible sur ce récepteur."

msgid "Administrator permission is required to install updates."
msgstr "Des droits administrateur sont requis pour installer les mises à jour."

msgid "Package configuration failed. Restart the receiver and retry."
msgstr "Échec de la configuration du paquet. Redémarrez le récepteur et réessayez."

msgid "Unexpected update error. Restart the receiver and retry."
msgstr "Erreur de mise à jour inattendue. Redémarrez le récepteur et réessayez."

msgid "Update installed, but its status could not be saved. Restart the interface."
msgstr "Mise à jour installée, mais son état n’a pas pu être enregistré. Redémarrez l’interface."
