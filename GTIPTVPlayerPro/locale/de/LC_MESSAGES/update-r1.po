# Updater 1.8.5-r1: translated failure reasons.
msgid ""
msgstr "Project-Id-Version: GT IPTV Player Pro 1.4.0\nReport-Msgid-Bugs-To: https://github.com/VicTuS59/GT-IPTV-Player-Pro/issues\nPO-Revision-Date: 2026-10-01 19:14+0000\nLast-Translator: GT IPTV Player Pro contributors\nLanguage-Team: German\nLanguage: de\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Cannot connect to the update server. Check the network and retry."
msgstr "Keine Verbindung zum Update-Server. Netzwerk prüfen und erneut versuchen."

msgid "DNS lookup failed. Check the network settings."
msgstr "DNS-Auflösung fehlgeschlagen. Netzwerkeinstellungen prüfen."

msgid "Secure connection failed. Check the receiver date and certificates."
msgstr "Sichere Verbindung fehlgeschlagen. Datum und Zertifikate des Receivers prüfen."

msgid "Update server returned HTTP {status}. Try again later."
msgstr "Der Update-Server meldet HTTP {status}. Später erneut versuchen."

msgid "Download interrupted. Download the update again."
msgstr "Download unterbrochen. Das Update erneut herunterladen."

msgid "Storage is read-only."
msgstr "Der Speicher ist schreibgeschützt."

msgid "Storage access denied. Check permissions."
msgstr "Speicherzugriff verweigert. Berechtigungen prüfen."

msgid "Update settings could not be read or saved. Restart the receiver."
msgstr "Update-Einstellungen konnten nicht gelesen oder gespeichert werden. Receiver neu starten."

msgid "Stop the active recording before updating."
msgstr "Die laufende Aufnahme vor dem Update stoppen."

msgid "Pause active downloads before updating."
msgstr "Laufende Downloads vor dem Update pausieren."

msgid "Activity status could not be checked. Restart the receiver."
msgstr "Aktivitätsstatus konnte nicht geprüft werden. Receiver neu starten."

msgid "Another update is running. Please wait."
msgstr "Ein anderes Update läuft. Bitte warten."

msgid "Package installation failed. Check the installation log."
msgstr "Paketinstallation fehlgeschlagen. Installationsprotokoll prüfen."

msgid "Required package missing: {package}."
msgstr "Erforderliches Paket fehlt: {package}."

msgid "Package conflict. Check installed packages."
msgstr "Paketkonflikt. Installierte Pakete prüfen."

msgid "The package manager is busy. Try again later."
msgstr "Die Paketverwaltung ist beschäftigt. Später erneut versuchen."

msgid "The package manager is unavailable on this receiver."
msgstr "Die Paketverwaltung ist auf diesem Receiver nicht verfügbar."

msgid "Administrator permission is required to install updates."
msgstr "Für die Installation von Updates sind Administratorrechte erforderlich."

msgid "Package configuration failed. Restart the receiver and retry."
msgstr "Paketkonfiguration fehlgeschlagen. Receiver neu starten und erneut versuchen."

msgid "Unexpected update error. Restart the receiver and retry."
msgstr "Unerwarteter Update-Fehler. Receiver neu starten und erneut versuchen."

msgid "Update installed, but its status could not be saved. Restart the interface."
msgstr "Update installiert, aber der Status konnte nicht gespeichert werden. Oberfläche neu starten."
