# R106 software updater: single stable source
msgid "Software update"
msgstr "மென்பொருள் புதுப்பிப்பு"

msgid "Automatic update check"
msgstr "தானியங்கிப் புதுப்பிப்புச் சோதனை"

msgid "Check for updates"
msgstr "புதுப்பிப்புகளைச் சோதிக்கவும்"

msgid "Download and verify"
msgstr "பதிவிறக்கிச் சரிபார்க்கவும்"

msgid "Install update"
msgstr "புதுப்பிப்பை நிறுவவும்"

msgid "Update available"
msgstr "புதுப்பிப்பு உள்ளது"

msgid "Up to date"
msgstr "புதுப்பிக்கப்பட்டுள்ளது"

msgid "Update verified"
msgstr "புதுப்பிப்பு சரிபார்க்கப்பட்டது"

msgid "Restart interface"
msgstr "இடைமுகத்தை மீள்தொடங்கவும்"

msgid "Update source is not ready"
msgstr "புதுப்பிப்பு மூலம் இன்னும் தயாராகவில்லை"

msgid "Update signature is invalid"
msgstr "புதுப்பிப்பின் கையொப்பம் செல்லுபடியாகாது"

msgid "Invalid update information"
msgstr "புதுப்பிப்புத் தகவல் தவறானது"

msgid "Update package is invalid"
msgstr "புதுப்பிப்புத் தொகுப்பு செல்லுபடியாகாது"

msgid "Update is not compatible with this receiver"
msgstr "இந்தப் பெறுநருடன் புதுப்பிப்பு பொருந்தாது"

msgid "Stop recordings and downloads before updating"
msgstr "புதுப்பிக்கும் முன் பதிவுகளையும் பதிவிறக்கங்களையும் நிறுத்தவும்"

msgid "Update failed"
msgstr "புதுப்பிப்பு தோல்வியடைந்தது"

msgid "Update installed. Restart the interface."
msgstr "புதுப்பிப்பு நிறுவப்பட்டது. இடைமுகத்தை மீள்தொடங்கவும்."

msgid "Install the verified update?"
msgstr "சரிபார்க்கப்பட்ட புதுப்பிப்பை நிறுவவா?"

msgid "Update available. Open updater?"
msgstr "புதுப்பிப்பு உள்ளது. புதுப்பிப்புக் கருவியைத் திறக்கவா?"

msgid "Automatic checks run every 6 hours."
msgstr "ஒவ்வொரு 6 மணிநேரத்திற்கும் தானாகச் சோதிக்கப்படும்."

msgid "New version"
msgstr "புதிய பதிப்பு"

