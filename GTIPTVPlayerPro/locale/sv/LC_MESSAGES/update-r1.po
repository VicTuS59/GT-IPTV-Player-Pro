# Updater 1.8.5-r1: translated failure reasons.
msgid ""
msgstr "Project-Id-Version: GT IPTV Player Pro 1.4.0\nReport-Msgid-Bugs-To: https://github.com/VicTuS59/GT-IPTV-Player-Pro/issues\nPO-Revision-Date: 2026-10-01 19:14+0000\nLast-Translator: GT IPTV Player Pro contributors\nLanguage-Team: sv\nLanguage: sv\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Cannot connect to the update server. Check the network and retry."
msgstr "Kan inte ansluta till uppdateringsservern. Kontrollera nätverket och försök igen."

msgid "DNS lookup failed. Check the network settings."
msgstr "DNS-uppslagning misslyckades. Kontrollera nätverksinställningarna."

msgid "Secure connection failed. Check the receiver date and certificates."
msgstr "Säker anslutning misslyckades. Kontrollera mottagarens datum och certifikat."

msgid "Update server returned HTTP {status}. Try again later."
msgstr "Uppdateringsservern svarade med HTTP {status}. Försök igen senare."

msgid "Download interrupted. Download the update again."
msgstr "Hämtningen avbröts. Hämta uppdateringen igen."

msgid "Storage is read-only."
msgstr "Lagringen är skrivskyddad."

msgid "Storage access denied. Check permissions."
msgstr "Åtkomst till lagringen nekades. Kontrollera behörigheterna."

msgid "Update settings could not be read or saved. Restart the receiver."
msgstr "Uppdateringsinställningarna kunde inte läsas eller sparas. Starta om mottagaren."

msgid "Stop the active recording before updating."
msgstr "Stoppa den pågående inspelningen före uppdateringen."

msgid "Pause active downloads before updating."
msgstr "Pausa pågående hämtningar före uppdateringen."

msgid "Activity status could not be checked. Restart the receiver."
msgstr "Aktivitetsstatus kunde inte kontrolleras. Starta om mottagaren."

msgid "Another update is running. Please wait."
msgstr "En annan uppdatering pågår. Vänta."

msgid "Package installation failed. Check the installation log."
msgstr "Paketinstallationen misslyckades. Kontrollera installationsloggen."

msgid "Required package missing: {package}."
msgstr "Ett nödvändigt paket saknas: {package}."

msgid "Package conflict. Check installed packages."
msgstr "Paketkonflikt. Kontrollera installerade paket."

msgid "The package manager is busy. Try again later."
msgstr "Pakethanteraren är upptagen. Försök igen senare."

msgid "The package manager is unavailable on this receiver."
msgstr "Pakethanteraren är inte tillgänglig på den här mottagaren."

msgid "Administrator permission is required to install updates."
msgstr "Administratörsbehörighet krävs för att installera uppdateringar."

msgid "Package configuration failed. Restart the receiver and retry."
msgstr "Paketkonfigurationen misslyckades. Starta om mottagaren och försök igen."

msgid "Unexpected update error. Restart the receiver and retry."
msgstr "Oväntat uppdateringsfel. Starta om mottagaren och försök igen."

msgid "Update installed, but its status could not be saved. Restart the interface."
msgstr "Uppdateringen installerades, men dess status kunde inte sparas. Starta om gränssnittet."
