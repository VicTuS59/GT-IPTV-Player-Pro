# Live TV recording, r45.
msgid ""
msgstr "Content-Type: text/plain; charset=UTF-8\nLanguage: uk\n"

msgid "Live TV recording"
msgstr "Запис прямого ефіру"

msgid "Please set the recording folder in the plugin settings."
msgstr "Укажіть папку запису в налаштуваннях плагіна."

msgid "Recording started."
msgstr "Запис розпочато."

msgid "Recording stopped."
msgstr "Запис зупинено."

msgid "Recording failed. Check the storage device."
msgstr "Помилка запису. Перевірте накопичувач."

msgid "Recording is not available for this stream."
msgstr "Запис цього потоку недоступний."

msgid "Open the channel again to enable recording."
msgstr "Відкрийте канал повторно, щоб увімкнути запис."
