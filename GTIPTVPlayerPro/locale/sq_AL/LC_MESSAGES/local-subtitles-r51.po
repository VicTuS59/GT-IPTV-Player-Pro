msgid "Download folder: {}"
msgstr "Dosja e shkarkimeve: {}"

#, python-brace-format
msgid "Subtitle language: {}"
msgstr "Gjuha e titrave: {}"

msgid "Folder is not available."
msgstr "Dosja nuk është e disponueshme."

msgid "Use temporary folder"
msgstr "Përdor dosjen e përkohshme"

msgid "Device folders"
msgstr "Dosjet e pajisjes"

msgid "Downloaded subtitles"
msgstr "Titrat e shkarkuar"

msgid "Search results"
msgstr "Rezultatet e kërkimit"
