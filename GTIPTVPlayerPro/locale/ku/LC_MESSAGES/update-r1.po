# Updater 1.8.5-r1: translated failure reasons.
msgid ""
msgstr "Project-Id-Version: GT IPTV Player Pro 1.4.0\nReport-Msgid-Bugs-To: https://github.com/VicTuS59/GT-IPTV-Player-Pro/issues\nPO-Revision-Date: 2026-10-01 19:14+0000\nLast-Translator: GT IPTV Player Pro Team\nLanguage-Team: Kurdish (Kurmanji)\nLanguage: ku\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=2; plural=(n != 1); \n"

msgid "Cannot connect to the update server. Check the network and retry."
msgstr "Girêdan bi pêşkêşkara nûkirinê re nehat çêkirin. Torê kontrol bikin û dîsa biceribînin."

msgid "DNS lookup failed. Check the network settings."
msgstr "Lêgerîna DNS bi ser neket. Mîhengên torê kontrol bikin."

msgid "Secure connection failed. Check the receiver date and certificates."
msgstr "Girêdana ewle bi ser neket. Dîrok û sertîfîkayên wergirê kontrol bikin."

msgid "Update server returned HTTP {status}. Try again later."
msgstr "Pêşkêşkara nûkirinê HTTP {status} vegerand. Paşê dîsa biceribînin."

msgid "Download interrupted. Download the update again."
msgstr "Daxistin qut bû. Nûkirinê dîsa daxînin."

msgid "Storage is read-only."
msgstr "Cihê hilanînê tenê ji bo xwendinê ye."

msgid "Storage access denied. Check permissions."
msgstr "Gihîştina hilanînê hat redkirin. Destûran kontrol bikin."

msgid "Update settings could not be read or saved. Restart the receiver."
msgstr "Mîhengên nûkirinê nehatin xwendin an tomarkirin. Wergirê ji nû ve bidin destpêkirin."

msgid "Stop the active recording before updating."
msgstr "Berî nûkirinê tomarkirina çalak rawestînin."

msgid "Pause active downloads before updating."
msgstr "Berî nûkirinê daxistinên çalak rawestînin."

msgid "Activity status could not be checked. Restart the receiver."
msgstr "Rewşa çalakiyê nehat kontrolkirin. Wergirê ji nû ve bidin destpêkirin."

msgid "Another update is running. Please wait."
msgstr "Nûkirineke din di pêvajoyê de ye. Ji kerema xwe li bendê bimînin."

msgid "Package installation failed. Check the installation log."
msgstr "Sazkirina pakêtê bi ser neket. Qeyda sazkirinê kontrol bikin."

msgid "Required package missing: {package}."
msgstr "Pakêta pêwîst tune ye: {package}."

msgid "Package conflict. Check installed packages."
msgstr "Nakokiya pakêtan. Pakêtên sazkirî kontrol bikin."

msgid "The package manager is busy. Try again later."
msgstr "Rêvebera pakêtan mijûl e. Paşê dîsa biceribînin."

msgid "The package manager is unavailable on this receiver."
msgstr "Rêvebera pakêtan li ser vî wergirî nayê bikaranîn."

msgid "Administrator permission is required to install updates."
msgstr "Ji bo sazkirina nûkirinan destûra rêveber pêwîst e."

msgid "Package configuration failed. Restart the receiver and retry."
msgstr "Veavakirina pakêtê bi ser neket. Wergirê ji nû ve bidin destpêkirin û dîsa biceribînin."

msgid "Unexpected update error. Restart the receiver and retry."
msgstr "Çewtiyeke nûkirinê ya neçaverêkirî. Wergirê ji nû ve bidin destpêkirin û dîsa biceribînin."

msgid "Update installed, but its status could not be saved. Restart the interface."
msgstr "Nûkirin hate sazkirin, lê rewşa wê nehat tomarkirin. Navrûyê ji nû ve bidin destpêkirin."
