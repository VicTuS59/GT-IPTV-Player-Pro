# Updater 1.8.5-r1: translated failure reasons.
msgid ""
msgstr "Project-Id-Version: GT IPTV Player Pro 1.4.0\nReport-Msgid-Bugs-To: https://github.com/VicTuS59/GT-IPTV-Player-Pro/issues\nPO-Revision-Date: 2026-10-01 19:14+0000\nLast-Translator: GT IPTV Player Pro Team\nLanguage-Team: Persian\nLanguage: fa\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=2; plural=(n > 1); \n"

msgid "Cannot connect to the update server. Check the network and retry."
msgstr "اتصال به سرور به‌روزرسانی ممکن نیست. شبکه را بررسی و دوباره تلاش کنید."

msgid "DNS lookup failed. Check the network settings."
msgstr "تبدیل نام DNS ناموفق بود. تنظیمات شبکه را بررسی کنید."

msgid "Secure connection failed. Check the receiver date and certificates."
msgstr "اتصال امن ناموفق بود. تاریخ گیرنده و گواهی‌ها را بررسی کنید."

msgid "Update server returned HTTP {status}. Try again later."
msgstr "سرور به‌روزرسانی خطای HTTP {status} برگرداند. بعداً دوباره تلاش کنید."

msgid "Download interrupted. Download the update again."
msgstr "بارگیری قطع شد. به‌روزرسانی را دوباره بارگیری کنید."

msgid "Storage is read-only."
msgstr "حافظه فقط خواندنی است."

msgid "Storage access denied. Check permissions."
msgstr "دسترسی به حافظه رد شد. مجوزها را بررسی کنید."

msgid "Update settings could not be read or saved. Restart the receiver."
msgstr "خواندن یا ذخیره تنظیمات به‌روزرسانی ممکن نشد. گیرنده را راه‌اندازی مجدد کنید."

msgid "Stop the active recording before updating."
msgstr "پیش از به‌روزرسانی، ضبط در حال انجام را متوقف کنید."

msgid "Pause active downloads before updating."
msgstr "پیش از به‌روزرسانی، بارگیری‌های فعال را موقتاً متوقف کنید."

msgid "Activity status could not be checked. Restart the receiver."
msgstr "بررسی وضعیت فعالیت ممکن نشد. گیرنده را راه‌اندازی مجدد کنید."

msgid "Another update is running. Please wait."
msgstr "به‌روزرسانی دیگری در حال انجام است. لطفاً صبر کنید."

msgid "Package installation failed. Check the installation log."
msgstr "نصب بسته ناموفق بود. گزارش نصب را بررسی کنید."

msgid "Required package missing: {package}."
msgstr "بسته موردنیاز موجود نیست: {package}."

msgid "Package conflict. Check installed packages."
msgstr "تداخل بسته‌ها. بسته‌های نصب‌شده را بررسی کنید."

msgid "The package manager is busy. Try again later."
msgstr "مدیر بسته مشغول است. بعداً دوباره تلاش کنید."

msgid "The package manager is unavailable on this receiver."
msgstr "مدیر بسته در این گیرنده در دسترس نیست."

msgid "Administrator permission is required to install updates."
msgstr "برای نصب به‌روزرسانی‌ها مجوز مدیر لازم است."

msgid "Package configuration failed. Restart the receiver and retry."
msgstr "پیکربندی بسته ناموفق بود. گیرنده را راه‌اندازی مجدد و دوباره تلاش کنید."

msgid "Unexpected update error. Restart the receiver and retry."
msgstr "خطای غیرمنتظره در به‌روزرسانی. گیرنده را راه‌اندازی مجدد و دوباره تلاش کنید."

msgid "Update installed, but its status could not be saved. Restart the interface."
msgstr "به‌روزرسانی نصب شد، اما وضعیت آن ذخیره نشد. رابط کاربری را راه‌اندازی مجدد کنید."
