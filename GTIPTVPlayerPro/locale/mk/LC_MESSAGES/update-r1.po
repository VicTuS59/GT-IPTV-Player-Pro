# Updater 1.8.5-r1: translated failure reasons.
msgid ""
msgstr "Project-Id-Version: GT IPTV Player Pro 1.4.0\nReport-Msgid-Bugs-To: https://github.com/VicTuS59/GT-IPTV-Player-Pro/issues\nPO-Revision-Date: 2026-10-01 19:14+0000\nLast-Translator: GT IPTV Player Pro\nLanguage-Team: Macedonian\nLanguage: mk\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=2; plural=(n%10==1 && n%100!=11 ? 0 : 1);\n"

msgid "Cannot connect to the update server. Check the network and retry."
msgstr "Не може да се поврзе со серверот за ажурирање. Проверете ја мрежата и обидете се повторно."

msgid "DNS lookup failed. Check the network settings."
msgstr "Неуспешно DNS разрешување. Проверете ги мрежните поставки."

msgid "Secure connection failed. Check the receiver date and certificates."
msgstr "Безбедната врска не успеа. Проверете ги датумот и сертификатите на приемникот."

msgid "Update server returned HTTP {status}. Try again later."
msgstr "Серверот за ажурирање врати HTTP {status}. Обидете се подоцна."

msgid "Download interrupted. Download the update again."
msgstr "Преземањето е прекинато. Преземете го ажурирањето повторно."

msgid "Storage is read-only."
msgstr "Складиштето е само за читање."

msgid "Storage access denied. Check permissions."
msgstr "Пристапот до складиштето е одбиен. Проверете ги дозволите."

msgid "Update settings could not be read or saved. Restart the receiver."
msgstr "Поставките за ажурирање не може да се прочитаат или зачуваат. Рестартирајте го приемникот."

msgid "Stop the active recording before updating."
msgstr "Запрете го активното снимање пред ажурирање."

msgid "Pause active downloads before updating."
msgstr "Паузирајте ги активните преземања пред ажурирање."

msgid "Activity status could not be checked. Restart the receiver."
msgstr "Статусот на активноста не може да се провери. Рестартирајте го приемникот."

msgid "Another update is running. Please wait."
msgstr "Веќе се извршува друго ажурирање. Ве молиме почекајте."

msgid "Package installation failed. Check the installation log."
msgstr "Инсталацијата на пакетот не успеа. Проверете го дневникот за инсталација."

msgid "Required package missing: {package}."
msgstr "Недостига потребен пакет: {package}."

msgid "Package conflict. Check installed packages."
msgstr "Конфликт на пакети. Проверете ги инсталираните пакети."

msgid "The package manager is busy. Try again later."
msgstr "Управувачот со пакети е зафатен. Обидете се подоцна."

msgid "The package manager is unavailable on this receiver."
msgstr "Управувачот со пакети не е достапен на овој приемник."

msgid "Administrator permission is required to install updates."
msgstr "За инсталирање ажурирања се потребни администраторски права."

msgid "Package configuration failed. Restart the receiver and retry."
msgstr "Конфигурацијата на пакетот не успеа. Рестартирајте го приемникот и обидете се повторно."

msgid "Unexpected update error. Restart the receiver and retry."
msgstr "Неочекувана грешка при ажурирање. Рестартирајте го приемникот и обидете се повторно."

msgid "Update installed, but its status could not be saved. Restart the interface."
msgstr "Ажурирањето е инсталирано, но статусот не е зачуван. Рестартирајте го интерфејсот."
