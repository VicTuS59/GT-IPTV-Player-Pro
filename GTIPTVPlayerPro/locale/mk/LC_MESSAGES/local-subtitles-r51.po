msgid "Choose a subtitle file"
msgstr "Изберете датотека со преводи"

msgid "Download folder"
msgstr "Папка за преземање"

msgid "Use this folder"
msgstr "Користи ја оваа папка"

msgid "Local subtitles"
msgstr "Локални преводи"

msgid "GT subtitle downloads"
msgstr "Преземања на преводи GT"

msgid "Search subtitle files"
msgstr "Пребарај датотеки со преводи"

msgid "No subtitle files found."
msgstr "Не се пронајдени датотеки со преводи."

msgid "Could not read this folder."
msgstr "Не може да се прочита оваа папка."

msgid "Could not load this subtitle file."
msgstr "Не може да се вчита оваа датотека со преводи."

msgid "Could not save the download folder."
msgstr "Не може да се зачува папката за преземање."

msgid "Download folder saved."
msgstr "Папката за преземање е зачувана."

msgid "Subtitle download folder is unavailable. Choose another folder."
msgstr "Папката за преземање преводи не е достапна. Изберете друга папка."

msgid "Subtitle file is too large."
msgstr "Датотеката со преводи е преголема."

msgid "Only SRT and VTT subtitle files are supported."
msgstr "Поддржани се само датотеки со преводи SRT и VTT."

msgid "Searching subtitle files..."
msgstr "Пребарување датотеки со преводи..."

msgid "Search limit reached. Narrow your search."
msgstr "Достигнато е ограничувањето за пребарување. Стеснете го пребарувањето."

msgid "Temporary folder"
msgstr "Привремена папка"

msgid "Device storage"
msgstr "Складиште на уредот"

msgid "Up one folder"
msgstr "Една папка нагоре"

msgid "Subtitle language"
msgstr "Јазик на преводите"

msgid "Search this folder"
msgstr "Пребарај во оваа папка"

msgid "Local subtitle loaded."
msgstr "Локалниот превод е вчитан."

msgid "Automatic detection"
msgstr "Автоматско препознавање"

msgid "Choose a folder on HDD, USB or connected NAS."
msgstr "Изберете папка на HDD, USB или поврзан NAS."

msgid "The temporary folder is cleared when the receiver restarts."
msgstr "Привремената папка се празни кога приемникот се рестартира."

