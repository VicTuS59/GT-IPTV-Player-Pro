# Live TV recording, r45.
msgid ""
msgstr "Content-Type: text/plain; charset=UTF-8\nLanguage: et\n"

msgid "Live TV recording"
msgstr "Otse-TV salvestamine"

msgid "Please set the recording folder in the plugin settings."
msgstr "Määrake salvestuskaust lisamooduli seadetes."

msgid "Recording started."
msgstr "Salvestamine algas."

msgid "Recording stopped."
msgstr "Salvestamine peatati."

msgid "Recording failed. Check the storage device."
msgstr "Salvestamine ebaõnnestus. Kontrollige salvestusseadet."

msgid "Recording is not available for this stream."
msgstr "Selle voo salvestamine pole saadaval."

msgid "Open the channel again to enable recording."
msgstr "Salvestamise lubamiseks avage kanal uuesti."
