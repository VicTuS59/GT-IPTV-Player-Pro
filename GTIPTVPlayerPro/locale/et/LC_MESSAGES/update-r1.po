# Updater 1.8.5-r1: translated failure reasons.
msgid ""
msgstr "Project-Id-Version: GT IPTV Player Pro 1.4.0\nReport-Msgid-Bugs-To: https://github.com/VicTuS59/GT-IPTV-Player-Pro/issues\nPO-Revision-Date: 2026-10-01 19:14+0000\nLast-Translator: GT IPTV Player Pro contributors\nLanguage-Team: et\nLanguage: et\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Cannot connect to the update server. Check the network and retry."
msgstr "Uuendusserveriga ei saa ühendust. Kontrollige võrku ja proovige uuesti."

msgid "DNS lookup failed. Check the network settings."
msgstr "DNS-i nimepäring ebaõnnestus. Kontrollige võrguseadeid."

msgid "Secure connection failed. Check the receiver date and certificates."
msgstr "Turvaline ühendus ebaõnnestus. Kontrollige vastuvõtja kuupäeva ja sertifikaate."

msgid "Update server returned HTTP {status}. Try again later."
msgstr "Uuendusserver tagastas HTTP {status}. Proovige hiljem uuesti."

msgid "Download interrupted. Download the update again."
msgstr "Allalaadimine katkes. Laadige uuendus uuesti alla."

msgid "Storage is read-only."
msgstr "Andmekandja on kirjutuskaitstud."

msgid "Storage access denied. Check permissions."
msgstr "Juurdepääs andmekandjale keelatud. Kontrollige õigusi."

msgid "Update settings could not be read or saved. Restart the receiver."
msgstr "Uuendusseadeid ei saanud lugeda ega salvestada. Taaskäivitage vastuvõtja."

msgid "Stop the active recording before updating."
msgstr "Enne uuendamist peatage käimasolev salvestus."

msgid "Pause active downloads before updating."
msgstr "Enne uuendamist peatage aktiivsed allalaadimised."

msgid "Activity status could not be checked. Restart the receiver."
msgstr "Tegevuse olekut ei saanud kontrollida. Taaskäivitage vastuvõtja."

msgid "Another update is running. Please wait."
msgstr "Teine uuendus on juba käimas. Palun oodake."

msgid "Package installation failed. Check the installation log."
msgstr "Paketi paigaldamine ebaõnnestus. Kontrollige paigalduslogi."

msgid "Required package missing: {package}."
msgstr "Vajalik pakett puudub: {package}."

msgid "Package conflict. Check installed packages."
msgstr "Pakettide konflikt. Kontrollige paigaldatud pakette."

msgid "The package manager is busy. Try again later."
msgstr "Paketihaldur on hõivatud. Proovige hiljem uuesti."

msgid "The package manager is unavailable on this receiver."
msgstr "Paketihaldur pole selles vastuvõtjas saadaval."

msgid "Administrator permission is required to install updates."
msgstr "Uuenduste paigaldamiseks on vaja administraatori õigusi."

msgid "Package configuration failed. Restart the receiver and retry."
msgstr "Paketi seadistamine ebaõnnestus. Taaskäivitage vastuvõtja ja proovige uuesti."

msgid "Unexpected update error. Restart the receiver and retry."
msgstr "Ootamatu uuendusviga. Taaskäivitage vastuvõtja ja proovige uuesti."

msgid "Update installed, but its status could not be saved. Restart the interface."
msgstr "Uuendus paigaldati, kuid selle olekut ei saanud salvestada. Taaskäivitage kasutajaliides."
