msgid "Choose a subtitle file"
msgstr "Tria un fitxer de subtítols"

msgid "Download folder"
msgstr "Carpeta de baixades"

msgid "Use this folder"
msgstr "Utilitza aquesta carpeta"

msgid "Local subtitles"
msgstr "Subtítols locals"

msgid "GT subtitle downloads"
msgstr "Subtítols baixats amb GT"

msgid "Search subtitle files"
msgstr "Cerca fitxers de subtítols"

msgid "No subtitle files found."
msgstr "No s'ha trobat cap fitxer de subtítols."

msgid "Could not read this folder."
msgstr "No s'ha pogut llegir aquesta carpeta."

msgid "Could not load this subtitle file."
msgstr "No s'ha pogut carregar aquest fitxer de subtítols."

msgid "Could not save the download folder."
msgstr "No s'ha pogut desar la carpeta de baixades."

msgid "Download folder saved."
msgstr "Carpeta de baixades desada."

msgid "Subtitle download folder is unavailable. Choose another folder."
msgstr "La carpeta de baixades de subtítols no està disponible. Tria una altra carpeta."

msgid "Subtitle file is too large."
msgstr "El fitxer de subtítols és massa gran."

msgid "Only SRT and VTT subtitle files are supported."
msgstr "Només s'admeten fitxers de subtítols SRT i VTT."

msgid "Searching subtitle files..."
msgstr "S'estan cercant fitxers de subtítols..."

msgid "Search limit reached. Narrow your search."
msgstr "S'ha assolit el límit de cerca. Acota la cerca."

msgid "Temporary folder"
msgstr "Carpeta temporal"

msgid "Device storage"
msgstr "Emmagatzematge del dispositiu"

msgid "Up one folder"
msgstr "Carpeta superior"

msgid "Subtitle language"
msgstr "Idioma dels subtítols"

msgid "Search this folder"
msgstr "Cerca en aquesta carpeta"

msgid "Local subtitle loaded."
msgstr "Subtítols locals carregats."

msgid "Automatic detection"
msgstr "Detecció automàtica"

msgid "Choose a folder on HDD, USB or connected NAS."
msgstr "Tria una carpeta en un HDD, un dispositiu USB o un NAS connectat."

msgid "The temporary folder is cleared when the receiver restarts."
msgstr "La carpeta temporal es buida quan es reinicia el receptor."

