# Live TV recording, r45.
msgid ""
msgstr "Content-Type: text/plain; charset=UTF-8\nLanguage: da\n"

msgid "Live TV recording"
msgstr "Optagelse af live-tv"

msgid "Please set the recording folder in the plugin settings."
msgstr "Vælg optagelsesmappen i udvidelsens indstillinger."

msgid "Recording started."
msgstr "Optagelse startet."

msgid "Recording stopped."
msgstr "Optagelse stoppet."

msgid "Recording failed. Check the storage device."
msgstr "Optagelsen mislykkedes. Kontrollér lagerenheden."

msgid "Recording is not available for this stream."
msgstr "Optagelse er ikke tilgængelig for denne stream."

msgid "Open the channel again to enable recording."
msgstr "Åbn kanalen igen for at aktivere optagelse."
