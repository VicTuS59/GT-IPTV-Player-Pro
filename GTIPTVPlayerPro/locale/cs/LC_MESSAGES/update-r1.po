# Updater 1.8.5-r1: translated failure reasons.
msgid ""
msgstr "Project-Id-Version: GT IPTV Player Pro 1.4.0\nReport-Msgid-Bugs-To: https://github.com/VicTuS59/GT-IPTV-Player-Pro/issues\nPO-Revision-Date: 2026-10-01 19:14+0000\nLast-Translator: GT IPTV Player Pro contributors\nLanguage-Team: cs\nLanguage: cs\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=3; plural=(n == 1) ? 0 : (n >= 2 && n <= 4) ? 1 : 2;\n"

msgid "Cannot connect to the update server. Check the network and retry."
msgstr "Nelze se připojit k serveru aktualizací. Zkontrolujte síť a zkuste to znovu."

msgid "DNS lookup failed. Check the network settings."
msgstr "Překlad DNS selhal. Zkontrolujte nastavení sítě."

msgid "Secure connection failed. Check the receiver date and certificates."
msgstr "Zabezpečené připojení selhalo. Zkontrolujte datum a certifikáty přijímače."

msgid "Update server returned HTTP {status}. Try again later."
msgstr "Server aktualizací vrátil HTTP {status}. Zkuste to později."

msgid "Download interrupted. Download the update again."
msgstr "Stahování přerušeno. Stáhněte aktualizaci znovu."

msgid "Storage is read-only."
msgstr "Úložiště je pouze pro čtení."

msgid "Storage access denied. Check permissions."
msgstr "Přístup k úložišti odepřen. Zkontrolujte oprávnění."

msgid "Update settings could not be read or saved. Restart the receiver."
msgstr "Nastavení aktualizací nelze přečíst nebo uložit. Restartujte přijímač."

msgid "Stop the active recording before updating."
msgstr "Před aktualizací zastavte probíhající nahrávání."

msgid "Pause active downloads before updating."
msgstr "Před aktualizací pozastavte aktivní stahování."

msgid "Activity status could not be checked. Restart the receiver."
msgstr "Stav aktivity nelze ověřit. Restartujte přijímač."

msgid "Another update is running. Please wait."
msgstr "Probíhá jiná aktualizace. Čekejte prosím."

msgid "Package installation failed. Check the installation log."
msgstr "Instalace balíčku selhala. Zkontrolujte protokol instalace."

msgid "Required package missing: {package}."
msgstr "Chybí požadovaný balíček: {package}."

msgid "Package conflict. Check installed packages."
msgstr "Konflikt balíčků. Zkontrolujte nainstalované balíčky."

msgid "The package manager is busy. Try again later."
msgstr "Správce balíčků je zaneprázdněn. Zkuste to později."

msgid "The package manager is unavailable on this receiver."
msgstr "Správce balíčků není na tomto přijímači dostupný."

msgid "Administrator permission is required to install updates."
msgstr "Instalace aktualizací vyžaduje oprávnění správce."

msgid "Package configuration failed. Restart the receiver and retry."
msgstr "Konfigurace balíčku selhala. Restartujte přijímač a zkuste to znovu."

msgid "Unexpected update error. Restart the receiver and retry."
msgstr "Neočekávaná chyba aktualizace. Restartujte přijímač a zkuste to znovu."

msgid "Update installed, but its status could not be saved. Restart the interface."
msgstr "Aktualizace nainstalována, ale její stav nelze uložit. Restartujte rozhraní."
