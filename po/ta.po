#: ../GTIPTVPlayerPro/m3u.py:1156 ../GTIPTVPlayerPro/m3u.py:1317
#: ../GTIPTVPlayerPro/m3u.py:1807 ../GTIPTVPlayerPro/m3u.py:1846
#: ../GTIPTVPlayerPro/m3u.py:2855 ../GTIPTVPlayerPro/m3u.py:2952
msgid "M3U source exceeds the safe size limit."
msgstr "M3U மூலமானது பாதுகாப்பான அளவு வரம்பை மீறுகிறது."

