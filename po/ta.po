msgid "M3U source header is missing."
msgstr "M3U மூலத் தலைப்பு விடுபட்டுள்ளது."

#: ../GTIPTVPlayerPro/m3u.py:1396
msgid "M3U source contains too many channels."
msgstr "M3U மூலத்தில் மிக அதிகமான சேனல்கள் உள்ளன."

#: ../GTIPTVPlayerPro/m3u.py:1422
msgid "M3U source contains too many categories."
msgstr "M3U மூலத்தில் மிக அதிகமான பிரிவுகள் உள்ளன."

#: ../GTIPTVPlayerPro/m3u.py:1459
msgid "M3U source does not contain playable channels."
msgstr "M3U மூலத்தில் இயக்கக்கூடிய சேனல்கள் இல்லை."

#: ../GTIPTVPlayerPro/m3u.py:1736
msgid "M3U file path traversal is not allowed."
msgstr "M3U கோப்புப் பாதை ஊடுருவல் அனுமதிக்கப்படவில்லை."

#: ../GTIPTVPlayerPro/m3u.py:1743
msgid "Symbolic links cannot be used as M3U sources."
msgstr "குறியீட்டு இணைப்புகளை M3U மூலங்களாகப் பயன்படுத்த முடியாது."

#: ../GTIPTVPlayerPro/m3u.py:1757
msgid "M3U file is outside the allowed directories."
msgstr "M3U கோப்பு அனுமதிக்கப்பட்ட கோப்பகங்களுக்கு வெளியே உள்ளது."

#: ../GTIPTVPlayerPro/m3u.py:1764 ../GTIPTVPlayerPro/m3u.py:1789
msgid "M3U file could not be opened."
msgstr "M3U கோப்பைத் திறக்க முடியவில்லை."

#: ../GTIPTVPlayerPro/m3u.py:1769 ../GTIPTVPlayerPro/m3u.py:1802
msgid "M3U source must be a regular file."
msgstr "M3U மூலம் ஒரு சாதாரண கோப்பாக இருக்க வேண்டும்."

#: ../GTIPTVPlayerPro/m3u.py:1855
msgid "M3U file changed while it was being read."
msgstr "M3U கோப்பு படிக்கப்பட்டுக் கொண்டிருந்தபோது மாற்றப்பட்டது."

#: ../GTIPTVPlayerPro/m3u.py:2622 ../GTIPTVPlayerPro/m3u.py:2627
msgid "M3U URL is invalid."
msgstr "M3U URL செல்லாதது."

#: ../GTIPTVPlayerPro/m3u.py:2636
msgid "M3U URL is not safe."
msgstr "M3U URL பாதுகாப்பானது அல்ல."

#: ../GTIPTVPlayerPro/m3u.py:2638
msgid "M3U URL port is invalid."
msgstr "M3U URL போர்ட் செல்லாதது."

#: ../GTIPTVPlayerPro/m3u.py:2642
msgid "M3U host name is invalid."
msgstr "M3U ஹோஸ்ட் பெயர் தவறானது."

#: ../GTIPTVPlayerPro/m3u.py:2666
msgid "M3U host address is invalid."
msgstr "M3U ஹோஸ்ட் முகவரி தவறானது."

#: ../GTIPTVPlayerPro/m3u.py:2677
msgid "M3U host address is not allowed."
msgstr "M3U ஹோஸ்ட் முகவரி அனுமதிக்கப்படவில்லை."

#: ../GTIPTVPlayerPro/m3u.py:2697
msgid "M3U host name resolution is busy."
msgstr "M3U ஹோஸ்ட் பெயர் தீர்மானிக்கும் பணி மும்முரமாக உள்ளது."

#: ../GTIPTVPlayerPro/m3u.py:2730
msgid "M3U host name could not be resolved."
msgstr "M3U ஹோஸ்ட் பெயரைத் தீர்மானிக்க முடியவில்லை."

#: ../GTIPTVPlayerPro/m3u.py:2746
msgid "M3U host resolved to an unsafe address set."
msgstr "M3U ஹோஸ்ட், பாதுகாப்பற்ற முகவரித் தொகுப்பிற்குத் தீர்மானிக்கப்பட்டது."

#: ../GTIPTVPlayerPro/m3u.py:2752
msgid "M3U redirect changed the network scope."
msgstr "M3U வழிமாற்றம் பிணைய எல்லையை மாற்றியது."

#: ../GTIPTVPlayerPro/m3u.py:2879
msgid "An HTTPS M3U request cannot be redirected to HTTP."
msgstr "ஒரு HTTPS M3U கோரிக்கையை HTTP-க்குத் திசைதிருப்ப முடியாது."

#: ../GTIPTVPlayerPro/m3u.py:2930
#, python-brace-format
